# ---------------------------------------------------------------------------
# AI PROVIDER — DeepSeek
# ---------------------------------------------------------------------------
#
# Used by the AI tutor (/api/chat), the PDF importer's question extraction and
# explanation stage, file categorisation, lesson summaries and keyword indexing.
#
# Obtain a key at platform.deepseek.com. Without it, every AI-backed endpoint
# returns a clear "DEEPSEEK_API_KEY is not set" error rather than failing
# silently; the rest of the platform is unaffected.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# NOTE: this provider is text-only. It cannot read attached files or browse the
# web, and /api/chat refuses an attachment rather than answering without it.
#
# OPTIONAL — UTME PDF importer explanation stage (local-first).
#
# auto (default) = use a running local Ollama if there is one, else DeepSeek.
# ollama         = local only; if it is not running, explanations are flagged for
#                  review and questions still save normally.
# deepseek       = always use the hosted model.
# gemini         = legacy alias for `deepseek`, kept so a deployment still
#                  setting the old value keeps working.
# EXPLANATION_PROVIDER=auto
#
# Ollama endpoint. Install from ollama.com and run `ollama serve`, then pull a
# model (`ollama pull llama3.1`). No Python and no sidecar are involved — this is
# a plain HTTP call from Node.
# OLLAMA_BASE_URL=http://localhost:11434
# Leave unset to auto-select the first model the local server has pulled.
# OLLAMA_MODEL=llama3.1
#
# Questions per explanation request. Higher = fewer AI calls per import.
# DEEPSEEK_EXPLANATION_BATCH_SIZE=10

FLUTTERWAVE_SECRET_KEY=
VITE_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
